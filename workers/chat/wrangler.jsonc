{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "only-bitcoin-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "SPACE_ROOM",
        "class_name": "SpaceRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SpaceRoom"]
    },
    {
      // 익명 공개 채팅 종료. 배포하면 ChatRoom 의 저장 데이터가 영구 삭제됨.
      "tag": "v3",
      "deleted_classes": ["ChatRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_UPGRADE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "CHAT_ALLOWED_ORIGINS": "https://www.only-btc.app,http://localhost:3002"
  }
}
