{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "only-bitcoin-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "SPACE_ROOM",
        "class_name": "SpaceRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SpaceRoom"]
    },
    {
      // 익명 공개 채팅 종료. 배포하면 ChatRoom 의 저장 데이터가 영구 삭제됨.
      "tag": "v3",
      "deleted_classes": ["ChatRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_UPGRADE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // 호출 로그는 끔. 웹소켓 메시지 하나(이동·공격)가 호출 하나라, 켜 두면 접속자 몇 명만으로
      // 하루 무료 한도를 다 씀. 한도가 차면 정작 봐야 할 오류 로그도 안 들어옴.
      // 코드가 직접 남기는 로그(console.error)는 그대로 들어감.
      "invocation_logs": false
    }
  },
  "vars": {
    "CHAT_ALLOWED_ORIGINS": "https://www.only-btc.app,http://localhost:3002"
  }
}
